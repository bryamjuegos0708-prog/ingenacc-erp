PORT=4000
HOST=0.0.0.0
NODE_ENV=production
INGENACC_SEED_MODE=operational
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/ingenacc.db
